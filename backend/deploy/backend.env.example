# Copy to /etc/patahao/backend.env, replace every placeholder, and restrict
# the installed file to root. Never commit the installed environment file.

PATAHAO_ENVIRONMENT=staging
DJANGO_DEBUG=false
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.staging.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.staging.example.com
DJANGO_LOG_LEVEL=INFO

DATABASE_URL=postgresql://user:password@db-host:5432/patahao_staging?sslmode=require
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=5

ENABLE_DEVELOPMENT_PAYMENT_HANDOFF=false
DJANGO_STATIC_ROOT=/srv/patahao/current/backend/staticfiles
DJANGO_MEDIA_ROOT=/var/lib/patahao/media
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-me
DJANGO_EMAIL_HOST_PASSWORD=replace-me
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=20
DJANGO_DEFAULT_FROM_EMAIL="Pata HAO <no-reply@example.com>"

PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# Staging never collects real customer money.
MPESA_ENVIRONMENT=sandbox
MPESA_LIVE_PAYMENTS_ENABLED=false
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_HTTP_TIMEOUT=30

VIDEO_FFPROBE_BINARY=ffprobe
VIDEO_FFMPEG_BINARY=ffmpeg
VIDEO_PROCESSING_TIMEOUT_SECONDS=45

GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT_SECONDS=120
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
GUNICORN_KEEPALIVE_SECONDS=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
