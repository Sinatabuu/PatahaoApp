# Runtime mode: development, staging, or production.
PATAHAO_ENVIRONMENT=development
DJANGO_DEBUG=true

# Required in staging and production. Generate a long, random value.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=DEBUG

# Development defaults to backend/db.sqlite3 when this is blank.
# Staging and production require a PostgreSQL URL.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=5

# This is ignored outside development and whenever DJANGO_DEBUG=false.
ENABLE_DEVELOPMENT_PAYMENT_HANDOFF=true

DJANGO_STATIC_ROOT=
DJANGO_MEDIA_ROOT=
DJANGO_SECURE_HSTS_SECONDS=
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Development prints recovery emails in the backend terminal. Staging and
# production use SMTP and require the host, username, password, and sender.
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=20
DJANGO_DEFAULT_FROM_EMAIL=
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

MPESA_ENVIRONMENT=sandbox
MPESA_LIVE_PAYMENTS_ENABLED=false
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_HTTP_TIMEOUT=30

# Required by the property walkthrough upload pipeline.
VIDEO_FFPROBE_BINARY=ffprobe
VIDEO_FFMPEG_BINARY=ffmpeg
VIDEO_PROCESSING_TIMEOUT_SECONDS=45

# Gunicorn application server. The defaults bind only to local Nginx.
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT_SECONDS=120
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
GUNICORN_KEEPALIVE_SECONDS=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
